---
import { PHASE_FLOW } from '../lib/site';
---

<ol class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
  {
    PHASE_FLOW.map((step) => (
      <li class="pipeline-step">
        <span class="font-mono text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-accent-400">
          → {step.phase}
        </span>
        <p class="text-xs leading-relaxed text-ink-400">{step.short}</p>
      </li>
    ))
  }
</ol>