---
import { NAV, SITE } from '../lib/site';

const socials = [
  { label: 'GitHub', href: SITE.socials.github, icon: 'github' },
  { label: 'HackerOne', href: SITE.socials.hackerone, icon: 'h1' },
  { label: 'Instagram', href: SITE.socials.instagram, icon: 'ig' },
] as const;
---

<footer class="border-t border-ink-800 bg-ink-900/60">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="flex items-baseline gap-1 font-mono text-base font-semibold text-ink-100">
        <span class="text-accent-400">~</span>
        {SITE.domain}
      </p>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-ink-400">
        {SITE.tagline}. I build secure software, break it on purpose, and write about what
        both sides taught me.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <a href={`mailto:${SITE.email}`} class="link-accent font-mono text-sm">{SITE.email}</a>
        <span class="text-ink-600">·</span>
        <a href={SITE.socials.hackerone} class="link-accent font-mono text-sm" target="_blank" rel="noopener">HackerOne</a>
      </div>
    </div>

    <nav aria-label="Footer">
      <p class="section-eyebrow mb-4" data-style="2">Navigate</p>
      <ul class="space-y-2 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="text-ink-300 transition-colors hover:text-accent-300">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="section-eyebrow mb-4" data-style="2">Elsewhere</p>
      <ul class="space-y-2 text-sm">
        {
          socials.map((s) => (
            <li class="flex items-center gap-2">
              <span class="font-mono text-xs text-accent-400">▸</span>
              <a href={s.href} class="text-ink-300 transition-colors hover:text-accent-300" target="_blank" rel="noopener">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 font-mono text-xs text-ink-500">PGP · fingerprint available on request</p>
    </div>
  </div>

  <div class="border-t border-ink-800">
    <div class="container-page flex flex-col items-start justify-between gap-3 py-6 font-mono text-xs text-ink-500 sm:flex-row sm:items-center">
      <p>© {new Date().getFullYear()} {SITE.author}. All rights reserved.</p>
      <p>Built with <a href="https://astro.build" class="link-accent" target="_blank" rel="noopener">Astro</a> · Dark mode only</p>
    </div>
  </div>
</footer>