---
import type { Project } from '../lib/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const statusLabel = { active: 'active', maintained: 'maintained', archived: 'archived' }[project.data.status];
---

<article class="card group relative flex h-full flex-col gap-3 p-5">
  <a
    href={`/projects/${project.id}`}
    class="absolute inset-0 z-0 rounded-[inherit]"
    aria-label={`View project: ${project.data.title}`}
  />

  <div class="flex items-center justify-between gap-3">
    <span class="font-mono text-xl text-accent-400" aria-hidden="true">{project.data.icon}</span>
    <span class="chip" data-status={project.data.status}>
      <span class="status-dot" data-status={project.data.status} aria-hidden="true"></span>
      {statusLabel}
    </span>
  </div>

  <h3 class="text-lg font-bold leading-snug text-ink-100 transition-colors group-hover:text-accent-300">
    {project.data.title}
  </h3>

  <p class="flex-1 text-sm leading-relaxed text-ink-400">{project.data.description}</p>

  <div class="flex flex-wrap gap-1.5">
    {project.data.tags.slice(0, 4).map((tag) => (
      <span class="chip">{tag}</span>
    ))}
  </div>

  <div class="mt-auto flex flex-wrap items-center gap-x-2 gap-y-1.5 font-mono text-xs">
    {project.data.repo && (
      <a href={project.data.repo} target="_blank" rel="noopener" class="relative z-20 rounded border border-ink-600 px-2 py-0.5 text-ink-300 transition-colors hover:border-accent-500 hover:text-accent-300">repo ↗</a>
    )}
    {project.data.demo && (
      <a href={project.data.demo} target="_blank" rel="noopener" class="relative z-20 rounded border border-accent-500/60 bg-accent-500/10 px-2 py-0.5 text-accent-300 transition-colors hover:border-accent-400">demo ↗</a>
    )}
    {project.data.docs && (
      <a href={project.data.docs} target="_blank" rel="noopener" class="relative z-20 rounded border border-ink-600 px-2 py-0.5 text-ink-300 transition-colors hover:border-accent-500 hover:text-accent-300">docs ↗</a>
    )}
    {project.data.link && (
      <a href={project.data.link} target="_blank" rel="noopener" class="relative z-20 rounded border border-ink-600 px-2 py-0.5 text-ink-300 transition-colors hover:border-accent-500 hover:text-accent-300">link ↗</a>
    )}
    <span class="ml-auto inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-ink-500 transition-colors group-hover:text-accent-300">
      details →
    </span>
  </div>
</article>
