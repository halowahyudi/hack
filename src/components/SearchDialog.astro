---
const { title = 'Search wahyudi.dev' } = Astro.props;
---

<div
  id="search-overlay"
  class="fixed inset-0 z-50 hidden items-start justify-center bg-ink-950/70 pt-[12vh] p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
>
  <div class="w-full max-w-xl overflow-hidden rounded-xl border border-ink-600 bg-ink-900 shadow-2xl">
    <div class="flex items-center gap-3 border-b border-ink-700 px-4 py-3">
      <svg class="h-4 w-4 shrink-0 text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder={title}
        autocomplete="off"
        spellcheck="false"
        class="w-full bg-transparent font-mono text-sm text-ink-100 outline-none"
        aria-label="Search query"
      />
      <button id="search-close" type="button" class="font-mono text-xs text-ink-400 hover:text-ink-100" aria-label="Close search">
        ESC
      </button>
    </div>
    <div id="search-status" class="px-4 pt-3 font-mono text-xs text-ink-500"></div>
    <ul id="search-results" class="max-h-[50vh] overflow-y-auto p-2"></ul>
  </div>
</div>

<script>
  const overlay = document.getElementById('search-overlay')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const closeBtn = document.getElementById('search-close');
  const statusEl = document.getElementById('search-status');
  const resultsEl = document.getElementById('search-results') as HTMLUListElement;

  const open = () => {
    overlay?.classList.remove('hidden');
    overlay?.classList.add('flex');
    setTimeout(() => input?.focus(), 30);
  };
  const close = () => {
    overlay?.classList.add('hidden');
    overlay?.classList.remove('flex');
    resultsEl!.innerHTML = '';
    statusEl!.textContent = '';
    if (input) input.value = '';
  };

  window.addEventListener('open-site-search', open);

  const onKey = (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      close();
      return;
    }
    const t = e.target as HTMLElement;
    const typing = !!t.matches && t.matches('input, textarea, [contenteditable="true"]');
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      open();
      return;
    }
    if (e.key === '/' && !typing) {
      e.preventDefault();
      open();
    }
  };
  document.addEventListener('keydown', onKey);
  closeBtn?.addEventListener('click', close);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  let pagefind: any = null;
  const pagefindUrl = '/pagefind/pagefind.js';
  type LoadedResult = {
    url: string;
    meta: { title?: string; description?: string };
    excerpt?: string;
    sub_results?: { title: string; url: string; excerpt: string }[];
  };

  const escapeHtml = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  const escapeRegExp = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

  const highlight = (text: string, terms: string[]) => {
    if (terms.length === 0) return escapeHtml(text);
    const re = new RegExp(`(${terms.map(escapeRegExp).join('|')})`, 'gi');
    return escapeHtml(text).replace(re, '<mark>$1</mark>');
  };

  const render = (loaded: LoadedResult[], query: string) => {
    resultsEl!.innerHTML = '';
    if (loaded.length === 0) {
      statusEl!.textContent = `No results for “${query}”.`;
      return;
    }
    statusEl!.textContent = `${loaded.length} result${loaded.length > 1 ? 's' : ''} for “${query}”`;

    const terms = query.split(/\s+/).filter((t) => t.length > 1);

    for (const r of loaded) {
      const li = document.createElement('li');

      const a = document.createElement('a');
      a.href = r.url;
      a.className = 'block rounded-lg px-3 py-2.5 transition-colors hover:bg-ink-800';

      const title = document.createElement('p');
      title.className = 'text-sm font-semibold text-ink-100';
      title.innerHTML = highlight(r.meta?.title || r.url, terms);

      const excerpt = document.createElement('p');
      excerpt.className = 'mt-1 text-xs leading-relaxed text-ink-400';
      if (r.excerpt) {
        excerpt.innerHTML = r.excerpt;
      } else if (r.meta?.description) {
        excerpt.innerHTML = highlight(r.meta.description, terms);
      }

      a.append(title);
      if (excerpt.innerHTML) a.append(excerpt);

      if (r.sub_results && r.sub_results.length > 0) {
        const subs = document.createElement('ul');
        subs.className = 'mt-1.5 space-y-0.5';
        for (const sub of r.sub_results.slice(0, 3)) {
          const sli = document.createElement('li');
          const sa = document.createElement('a');
          sa.href = sub.url;
          sa.className = 'block truncate text-[0.7rem] text-ink-500 hover:text-accent-300';
          sa.innerHTML = `↳ ${highlight(sub.title, terms)}`;
          sli.appendChild(sa);
          subs.appendChild(sli);
        }
        a.append(subs);
      }

      li.appendChild(a);
      resultsEl!.appendChild(li);
    }
  };

  let timer: ReturnType<typeof setTimeout> | undefined;
  input?.addEventListener('input', () => {
    clearTimeout(timer);
    const q = input.value.trim();
    if (!q) {
      statusEl!.textContent = '';
      resultsEl!.innerHTML = '';
      return;
    }
    statusEl!.textContent = 'Searching index…';
    timer = setTimeout(async () => {
      try {
        if (!pagefind) {
          const dynamicImport = new Function('p', 'return import(p)') as (p: string) => Promise<any>;
          pagefind = await dynamicImport(pagefindUrl);
        }
        const search = await pagefind.search(q);
        const loaded = (await Promise.all(search.results.map((r: any) => r.data()))) as LoadedResult[];
        render(loaded, q);
      } catch (e) {
        statusEl!.textContent = 'Search index unavailable. Run `npm run build` to generate it.';
        console.warn('pagefind unavailable:', e);
      }
    }, 180);
  });
</script>