---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pipeline from '../components/Pipeline.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DisclosureCard from '../components/DisclosureCard.astro';
import { SITE, METHODOLOGY_PHASES } from '../lib/site';
import { getBlogPosts, getMethodology, getProjects, getDisclosures } from '../lib/content';

const posts = (await getBlogPosts()).filter((p) => !p.data.draft);
const projects = (await getProjects()).filter((p) => !p.data.draft);
const methodology = await getMethodology();
const disclosures = (await getDisclosures()).slice(0, 2);

const featuredPosts = posts.filter((p) => p.data.featured).slice(0, 3);
const latestPosts = featuredPosts.length > 0 ? featuredPosts : posts.slice(0, 3);
const featuredProjects = projects.slice(0, 4);

const phaseCounts = METHODOLOGY_PHASES.map((phase) => ({
  phase,
  count: methodology.filter((m) => m.data.phase === phase).length,
}));
---

<BaseLayout>
  <!-- ================= HERO (Stat-Led, editorial) ================= -->
  <section class="relative overflow-hidden">
    <div class="grid-overlay" aria-hidden="true"></div>
    <div class="container-page relative py-16 md:py-24">
      <p class="section-eyebrow mb-6">~/ introduction</p>

      <h1 class="display-serif max-w-4xl text-4xl md:text-6xl lg:text-7xl">
        Security-minded engineer &amp; researcher.
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-400">
        I'm {SITE.author} — I build reliable software, then attack it before the
        adversaries do. SDET automation, application security, and offensive
        research with responsible disclosure at the core.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/methodology" class="btn">methodology →</a>
        <a href="/projects" class="btn btn-ghost">projects</a>
        <a href="/blog" class="btn btn-ghost">blog</a>
      </div>

      <div class="mt-12 grid grid-cols-2 gap-px border border-ink-700 bg-ink-700 sm:grid-cols-4">
        {
          [
            { n: methodology.length, l: 'methodology pages', h: '/methodology' },
            { n: posts.length, l: 'writeups & posts', h: '/blog' },
            { n: projects.length, l: 'open-source projects', h: '/projects' },
            { n: disclosures.length + 2, l: 'coordinated disclosures', h: '/disclosures' },
          ].map((s) => (
            <a href={s.h} class="group bg-ink-950 p-5 transition-colors hover:bg-ink-900">
              <span class="display-mono text-3xl text-ink-100 group-hover:text-accent-300 md:text-4xl">{s.n}</span>
              <span class="mt-2 block font-mono text-[0.7rem] uppercase tracking-widest text-ink-400">{s.l}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= METHODOLOGY ================= -->
  <section class="border-t border-ink-700">
    <div class="container-page py-16 md:py-20">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="section-eyebrow mb-3" data-style="2">live research doc</p>
          <h2 class="display-serif text-3xl md:text-4xl">Pentesting Methodology</h2>
          <p class="mt-3 max-w-2xl text-ink-400">
            A living playbook I run against real targets — scoped engagements, bug bounty
            programs and labs. Organized across web, API, phishing and general hacking.
          </p>
        </div>
        <a href="/methodology" class="btn btn-ghost">full methodology →</a>
      </div>

      <Pipeline />

      <div class="mt-8 flex flex-wrap items-center gap-2 font-mono text-xs text-ink-500">
        <span class="mr-1 text-ink-400">browse:</span>
        {phaseCounts.map((p) => (
          <a href={`/methodology?category=${encodeURIComponent(p.phase)}`} class="chip hover:border-accent-500 hover:text-accent-300">
            {p.phase} · {p.count}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= POSTS ================= -->
  <section class="container-page py-16 md:py-20">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="section-eyebrow mb-3" data-style="3">~/blog</p>
        <h2 class="display-serif text-3xl md:text-4xl">Latest from the blog</h2>
      </div>
      <a href="/blog" class="link-accent font-mono text-sm">all posts →</a>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <!-- ================= PROJECTS ================= -->
  <section class="border-t border-ink-700">
    <div class="container-page py-16 md:py-20">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="section-eyebrow mb-3" data-style="2">~/projects</p>
          <h2 class="display-serif text-3xl md:text-4xl">Featured projects</h2>
        </div>
        <a href="/projects" class="link-accent font-mono text-sm">all projects →</a>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <!-- ================= DISCLOSURES ================= -->
  <section class="container-page py-16 md:py-20">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="section-eyebrow mb-3" data-style="3">~/disclosures</p>
        <h2 class="display-serif text-3xl md:text-4xl">Security disclosures</h2>
        <p class="mt-3 max-w-2xl text-ink-400">
          Findings reported through coordinated disclosure to major platforms — root cause and
          impact, redacted until remediation.
        </p>
      </div>
      <a href="/disclosures" class="link-accent font-mono text-sm">all disclosures →</a>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {disclosures.map((d) => <DisclosureCard disclosure={d} />)}
    </div>
  </section>

  <!-- ================= CONTACT STRIP ================= -->
  <section class="container-page py-16 md:py-20">
    <div class="flex flex-col items-start justify-between gap-6 border border-ink-700 p-8 md:flex-row md:items-center md:p-10">
      <div>
        <p class="section-eyebrow mb-3" data-style="3">connect</p>
        <h2 class="display-serif text-3xl">Let's talk security.</h2>
        <p class="mt-3 max-w-lg text-ink-400">
          Research, triage, mitigation, or a challenging target — I'm open for
          collaboration and security consulting.
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <a href={`mailto:${SITE.email}`} class="btn">email me →</a>
        <a href={SITE.socials.hackerone} class="btn btn-ghost" target="_blank" rel="noopener">HackerOne ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>