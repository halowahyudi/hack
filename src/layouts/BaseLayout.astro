---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { SITE } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  tags,
  image,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;

const pathname = Astro.url.pathname.replace(/^\/|\/$/g, '');
const generatedOgPath = pathname === '' ? '/og/index.png' : `/og/${pathname}.png`;
const ogImage = new URL(image ?? generatedOgPath, SITE.url).href;

const personLd = {
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  email: SITE.email,
  sameAs: [SITE.socials.github, SITE.socials.hackerone, SITE.socials.instagram],
  jobTitle: 'Software Engineer, SDET, Application Security & Security Researcher',
};

const baseLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personLd,
    { '@type': 'WebSite', name: SITE.title, url: SITE.url, inLanguage: SITE.locale },
  ],
};

const articleLd =
  ogType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: title,
        description,
        url: canonical,
        image: ogImage,
        inLanguage: SITE.locale,
        author: { '@type': 'Person', name: SITE.author, url: SITE.url },
        publisher: { '@type': 'Person', name: SITE.author, url: SITE.url },
        ...(publishedTime ? { datePublished: publishedTime.toISOString() } : {}),
        ...(modifiedTime ? { dateModified: modifiedTime.toISOString() } : {}),
        ...(tags && tags.length ? { keywords: tags.join(', ') } : {}),
      }
    : null;

const blocks = [baseLd, articleLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])].filter(Boolean);
---

<!doctype html>
<html lang={SITE.locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05070d" />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/default-og.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(blocks.length === 1 ? blocks[0] : blocks)} is:inline />
  </head>
  <body class="min-h-screen flex flex-col bg-ink-950 text-ink-200">
    <Nav />
    <SearchDialog />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
